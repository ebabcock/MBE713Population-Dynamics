Prob.first=rep(c(0.512,0.488),each=2),
Second=rep(c("boy","girl"),2),
Prob.second=rep(c(0.512,0.488),2))
kids
kids$family.prob<-round(kids$Prob.first*kids$Prob.second,3)
kids
wasps<-data.frame(Parasitized=rep(c("yes","no"),each=2),
Prob.parasitized=rep(c(0.2,0.8),each=2),
Sex=rep(c("M","F"),2),
Prob.sex=c(0.9,0.1,0.05,0.95))
wasps$Total.Prob=wasps$Prob.parasitized*wasps$Prob.sex
wasps
#Prob. male
sum(wasps$Total.Prob[wasps$Sex=="M"])
wasps %>% filter(Sex=="M") %>%
summarize(total=sum(Total.Prob))
# Prob that host was parasitized | male egg (Bayes rule)
wasps$Total.Prob[wasps$Parasitized=="yes" & wasps$Sex=="M"]/
sum(wasps$Total.Prob[wasps$Sex=="M"])
