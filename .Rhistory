library(ggplot2)
library(tidyverse)
theme_set(theme_bw())
#theme_set(theme_bw())
## example Rm
Rm<-0.25
lambda<-1+Rm
N0<-100
Population<-data.frame(t=0:9,N=NA)
Population$N[1]<-N0
for(i in 2:10) {
Population$N[i]<-Population$N[i-1]*lambda
}
Population
Population<-data.frame(t=0:9)
Population$N<-N0*lambda^(Population$t)
Population
#
ggplot(Population,
aes(x=t,y=N))+
geom_line()
##multiple values
Rm<-c(-0.25,0,0.1,0.25)
lambda<-1+Rm
N0<-100
Population<-expand.grid(t=0:9,lambda=lambda)
Population$Rm<-Population$lambda-1
Population$N<-N0*Population$lambda^(Population$t)
head(Population)
view(Population)
ggplot(Population,
aes(x=t,
y=N,
color=factor(Rm)))+
geom_line()
ggplot(Population,
aes(x=t,
y=log(N),
color=factor(Rm)))+
geom_line()
