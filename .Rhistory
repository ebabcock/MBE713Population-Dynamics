library(tidyverse)
theme_set(theme_bw())
n <- 20
heads <- 13
# Likelihood of p = 0.5, given the data
dbinom(x = heads, size = n, prob = 0.5)
p_grid <- tibble(p = seq(0.01, 0.99, by = 0.01)) |>
mutate(likelihood = dbinom(x = heads, size = n, prob = p),
likelihood2 =dbinom(x = heads*10, size = n*10, prob = p)
p_grid |>
ggplot(p_grid, aes(x = p, y = likelihood)) +
geom_line(aes(color="heads=13, n=20")) +
geom_line(aes(y=likelihood2,color="heads=130,n=200"))+
geom_vline(xintercept = heads / n, linetype = "dashed", color = "red") +
scale_color_manual(values=c("purple","darkgreen"))
