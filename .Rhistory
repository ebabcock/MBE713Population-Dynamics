n<-20
k<-13
binomialNLL<-function(p,k,n) {
negLL<- -dbinom(k,n,p,log=TRUE)
return(negLL)
}
heads<-13
n<-20
heads<-13
binomialNLL(p=0.5,k=heads,n=n)
?optim
n<-20
heads<-13
