getLeslie<-function(lx,mx) {
Pvals<-lx[2:6]/lx[1:5]
Fvals<-mx[2:6]*Pvals
Leslie<-matrix(0,5,5)
Leslie[1,]<-Fvals
for(i in 1:4) Leslie[i+1,i]<-Pvals[i]
Leslie
}
