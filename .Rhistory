RegressionNLL<-function(par,x,y,s) {
a<-par["a"]
b<-par["b"]
s<-par["s"]
y_hat<-a+b*x
LL<-sum(dnorm(y,mean=y_hat,sd=s))
return(-LL)
}
RegressionNLL<-function(par,x,y,s) {
a<-par["a"]
b<-par["b"]
s<-par["s"]
y_hat<-a+b*x
LL<-sum(dnorm(y,mean=y_hat,sd=s))
return(-LL)
}
fit<-optim(par=c(a=0,b=1,s=1),
fn=RegressioNLL,
x=mpg$hwy,
y=mpg$cty)
