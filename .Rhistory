geom_line(aes(color="heads=13, n=20")) +
geom_line(aes(y=likelihood2,color="heads=130,n=200"))+
geom_vline(xintercept = heads / n, linetype = "dashed", color = "red") +
scale_color_manual(values=c("purple","darkgreen"))
