RegressionNLL<-function(par,x,y,s) {
a<-par["a"]
b<-par["b"]
s<-par["s"]
y_hat<-a+b*x
LL<-sum(dnorm(y,mean=y_hat,sd=s))
return(-LL)
}
RegressionNLL<-function(par,x,y,s) {
a<-par["a"]
b<-par["b"]
s<-par["s"]
y_hat<-a+b*x
LL<-sum(dnorm(y,mean=y_hat,sd=s))
return(-LL)
}
