RegressionSS<-function(par,x,y) {
a<-par["a"]
b<-par["b"]
y_hat<-a+b*x
SS<-sum((y-y_hat)^2)
return(SS)
}
RegressionSS(par=c(a=0.84,b=0.68),
x=mpg$cty,
y=mpg$hwy)
# find minimum
fit<-optim(par=c(a=0,b=1),
fn=RegressionSS,
x=mpg$hwy,
y=mpg$cty)
fit
fit
