library(tidyverse)
ggplot(mpg,aes(x=hwy,y=cty))+
geom_point()+
stat_smooth(method="lm")+
labs(x="Highway miles per gallon",y="City miles per gallon",
title="Fuel efficiency regression")
cars.lm<-lm(cty~hwy,data=mpg)
coef(cars.lm)
RegressionSS<-function(par,x,y) {
a<-par["a"]
b<-par["b"]
y_hat<-a+b*x
SS<-sum((y-y_hat)^2)
return(SS)
}
RegressionSS(<-function(c(a=0.8,b=0.8),x=mpg$)cty,y=mpg$hwy)
RegressionSS<-par=c(a=0.8,b=0.8),x=mpg$)cty,y=mpg$hwy)
return(SS)
RegressionSS<-function(par,x,y) {
a<-par["a"]
b<-par["b"]
y_hat<-a+b*x
SS<-sum((y-y_hat)^2)
return(SS)
}
fit<-optim(par=c(a=0,b=1),
fn=RegressionSS,
x=mpg$hwy,
y=mpg$cty)
fit
