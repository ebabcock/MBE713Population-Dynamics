library(tidyverse)
seeds<-tibble(habitat=c("high","medium","low"),
Proportion_habitat=c(0.3,0.2,0.5),
Prob_survive=c(0.8,0.3,0.1))
P_survive=with(seeds,sum(Proportion_habitat*Prob_survive))
P_survive
P_survive*0.8
Prob_Survive_High<-with(filter(seeds,habitat=="high"),Proportion_habitat*Prob_survive)
Prob_Survive_High<-with(filter(seeds,habitat=="high"),
Proportion_habitat*Prob_survive)
Prob_Survive_High
P_Survive_High<-with(filter(seeds,habitat=="high"),
Proportion_habitat*Prob_survive)
P_Survive_High/P_survive
P_Survive_High<-with(filter(seeds,habitat=="high"),
Proportion_habitat*Prob_survive)
P_Survive_High/P_survive
P_Survive_High/P_survive |> round(3)
P_Survive_High/P_survive |> round(.x,3)
P_Survive_High/P_survive |> round()
P_Survive_High/P_survive
P_Survive_High/P_survive %>% round(3)
