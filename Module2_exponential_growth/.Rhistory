geom_line(aes(y=ML,color="Lorenzen"))
#Now to get juvenile vs. adult mortality
MortalitySum<-Cohort %>%
mutate(LifeStage=ifelse(L<Lm,"Juvenile","Adult")) %>%
group_by(LifeStage)%>%
summarize(MD=mean(MD),
ML=mean(ML))
MortalitySum
#Now to get juvenile vs. adult mortality
#This can be weighted by numbers at age in each year
Cohort<-Cohort %>%
mutate(NL=exp(cumsum(ML)),
ND=exp(cumsum(MD)))
view(Cohort)
#Now to get juvenile vs. adult mortality
#This can be weighted by numbers at age in each year
Cohort<-Cohort %>%
mutate(NL=exp(cumsum(-ML)),
ND=exp(cumsum(-MD)))
#Now to get juvenile vs. adult mortality
#This can be weighted by numbers at age in each year
Cohort<-Cohort %>%
mutate(NL=exp(cumsum(-ML+ML[age==0])),
ND=exp(cumsum(-MD+ML[age==0])))
#Now to get juvenile vs. adult mortality
#This can be weighted by numbers at age in each year
Cohort<-Cohort %>%
mutate(NL=exp(cumsum(-ML+ML[t==0])),
ND=exp(cumsum(-MD+ML[t==0])))
#Now to get juvenile vs. adult mortality
#This can be weighted by numbers at age in each year
Cohort<-Cohort %>%
mutate(NL=exp(cumsum(-ML+ML[t==0])),
ND=exp(cumsum(-MD+MD[t==0])))
#Add numbers at age with each natural mortality vector
Cohort<-Cohort %>%
mutate(NL=exp(cumsum(-ML+ML[t==0])),
ND=exp(cumsum(-MD+MD[t==0])))
#Calculate juvenile vs. adult mortality, by each M methods, with or without weighting by numbers
MortalitySum<-Cohort %>%
mutate(LifeStage=ifelse(L<Lm,"Juvenile","Adult"),
ML.weighted=sum(ML*NL)/sum(NL),
MD.weighted=sum(ML*ND)/sum(ND),
ML.unweighted=mean(ML),
MD.unweigthed=mean(MD) ) %>%
group_by(LifeStage)%>%
summarize(MD.unweighted=mean(MD),
ML.unweighted=mean(ML))
MortalitySum
#Add numbers at age with each natural mortality vector
Cohort<-Cohort %>%
mutate(NL=exp(cumsum(-ML+ML[t==0])),
ND=exp(cumsum(-MD+MD[t==0])))
