library(tidyverse)
#Von Bertalanffy growth curve
VonBert<-function(t,Linf,K,t0) {
Linf*(1-exp(-K*(t-t0)))
}
# Lorenzen length method for M from length. First get average mortality rate from one
# of the empirical methods, then apply that to length at maturity(.
# You can use any of them, including the ones from Then et al. (2018)
M.Then=function(tmax) 4.899*tmax^(-.916)
M.Then.K=function(Linf,K) 4.118*K^0.73*(Linf*10)^(-0.33) #converted to cm from mm
# or the tmax estimator recommended by
M.Durueil.tmax<-function(tmax) {
exp(1.551-1.066*log(tmax))
}
#Then apply this mortality to the length at maturity and rescale to other ages
# as M is inversely proportional to L
M.Lorenzen.L<-function(L,Lm,Mref) {
Mref*Lm/L
}
#Durueil method
#First calculate average mortality from one of empiricial methods,
#apply this to a reference age calculatedd from tmax and then rescale M inversely proportional to length
#Durueil calls this the Lta method and recommends it for juveniles
M.Durueil.Lta<-function(L,tmax,Linf,K,t0) {
Mref<- M.tmax(tmax)  #with Durueil's recommend M estimator
tref<-(2/log(0.0178)+1)*tmax
Lref<-VonBert(tref,Linf,K,t0)
Mref*Lref/L
}
#Mako shark example numbers
#Values for mako N, scenario 3
Linf<-350.3
K<-0.064
t0<-log(1-63/Linf)/K
tmax<-32
Lm<- 12.525/0.046
#Make a data frame with the values for each age.
Cohort<-data.frame(t=0:tmax) %>%
mutate(L=VonBert(t,Linf,K,t0),
ML=M.Lorenzen.L(L,Lm,Mref),
MD=M.Dureuil.Lta(L,tmax,Linf,K,t0))
#Make a data frame with the values for each age.
Cohort<-data.frame(t=0:tmax) %>%
mutate(L=VonBert(t,Linf,K,t0),
ML=M.Lorenzen.L(L,Lm,Mref=M.Then(tmax)),
MD=M.Dureuil.Lta(L,tmax,Linf,K,t0))
#Make a data frame with the values for each age.
Cohort<-data.frame(t=0:tmax) %>%
mutate(L=VonBert(t,Linf,K,t0),
ML=M.Lorenzen.L(L,Lm,Mref=M.Then(tmax)),
MD=M.Durueil.Lta(L,tmax,Linf,K,t0))
#Durueil method
#First calculate average mortality from one of empiricial methods,
#apply this to a reference age calculatedd from tmax and then rescale M inversely proportional to length
#Durueil calls this the Lta method and recommends it for juveniles
M.Durueil.Lta<-function(L,tmax,Linf,K,t0) {
Mref<- M.Durueil.tmax(tmax)  #with Durueil's recommend M estimator
tref<-(2/log(0.0178)+1)*tmax
Lref<-VonBert(tref,Linf,K,t0)
Mref*Lref/L
}
#Make a data frame with the values for each age.
Cohort<-data.frame(t=0:tmax) %>%
mutate(L=VonBert(t,Linf,K,t0),
ML=M.Lorenzen.L(L,Lm,Mref=M.Then(tmax)),
MD=M.Durueil.Lta(L,tmax,Linf,K,t0))
ggplot(Cohort, aes(x=t,y=MD))+geom_line()
ggplot(Cohort, aes(x=t))+
geom_line(aes(y=MD,color="Durueil"))+
geom_Line(aes(y=ML,color="Lorenzen"))
ggplot(Cohort, aes(x=t))+
geom_line(aes(y=MD,color="Durueil"))+
geom_line(aes(y=ML,color="Lorenzen"))
#Durueil method
#First calculate average mortality from one of empiricial methods,
#apply this to a reference age calculatedd from tmax and then rescale M inversely proportional to length
#Durueil calls this the Lta method and recommends it for juveniles
M.Durueil.Lta<-function(L,tmax,Linf,K,t0,Mref) {
tref<-(2/log(0.0178)+1)*tmax
Lref<-VonBert(tref,Linf,K,t0)
Mref*Lref/L
}
#Mako shark example numbers
#Values for mako N, scenario 3
Linf<-350.3
K<-0.064
t0<-log(1-63/Linf)/K
tmax<-32
Lm<- 12.525/0.046
#Make a data frame with the values for each age.
Cohort<-data.frame(t=0:tmax) %>%
mutate(L=VonBert(t,Linf,K,t0),
ML=M.Lorenzen.L(L,Lm,Mref=M.Dureil(tmax)),
MD=M.Durueil.Lta(L,tmax,Linf,K,t0))
#Make a data frame with the values for each age.
#Using Duruil's tmax for both methods
Cohort<-data.frame(t=0:tmax) %>%
mutate(L=VonBert(t,Linf,K,t0,Mref=M.Dureil(tmax)),
ML=M.Lorenzen.L(L,Lm,Mref=M.Dureil(tmax)),
MD=M.Durueil.Lta(L,tmax,Linf,K,t0))
