# You can use any of them, including the ones from Then et al. (2018)
M.Then=function(tmax) 4.899*tmax^(-.916)
M.Then.K=function(Linf,K) 4.118*K^0.73*(Linf*10)^(-0.33) #converted to cm from mm
# or the tmax estimator recommended by
M.Durueil.tmax<-function(tmax) {
exp(1.551-1.066*log(tmax))
}
#Durueil method
#First calculate average mortality from one of empiricial methods,
#apply this to a reference age calculatedd from tmax and then rescale M inversely proportional to length
#Durueil calls this the Lta method and recommends it for juveniles
M.Durueil.Lta<-function(L,tmax,Linf,K,t0) {
Mref<- M.tmax(tmax)
tref<-(2/log(0.0178)+1)*tmax
Lref<-VonBert(tref,Linf,K,t0)
Mref*Lref/L
}
M.Dureuil.Lta(Lref,tmax,Linf,K,t0)
