t0<-log(1-63/Linf)/K
tmax<-32
Lm<- 12.525/0.046
#Make a data frame with the values for each age.
#Using Duruil's tmax for both methods
Cohort<-data.frame(t=0:tmax) %>%
mutate(L=VonBert(t,Linf,K,t0),
ML=M.Lorenzen.L(L,Lm,Mref=M.Dureil(tmax)),
MD=M.Durueil.Lta(L,tmax,Linf,K,t0,Mref=M.Dureil(tmax)))
#Make a data frame with the values for each age.
#Using Duruil's tmax for both methods
Cohort<-data.frame(t=0:tmax) %>%
mutate(L=VonBert(t,Linf,K,t0),
ML=M.Lorenzen.L(L,Lm,Mref=M.Durueil(tmax)),
MD=M.Durueil.Lta(L,tmax,Linf,K,t0,Mref=M.Durueil(tmax)))
#Make a data frame with the values for each age.
#Using Duruil's tmax for both methods
Cohort<-data.frame(t=0:tmax) %>%
mutate(L=VonBert(t,Linf,K,t0),
ML=M.Lorenzen.L(L,Lm,Mref=M.Durueil.tmax(tmax)),
MD=M.Durueil.Lta(L,tmax,Linf,K,t0,Mref=M.Durueil.tmax(tmax)))
ggplot(Cohort, aes(x=t))+
