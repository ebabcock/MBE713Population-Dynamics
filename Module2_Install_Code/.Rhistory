sperm_clean <- sperm %>%
mutate(
date=as.Date(event_date,format="%Y-%m-%d"),
year=year(date),
oceano_parsed = map(oceano, ~ fromJSON(.x)),
sst   = map_dbl(oceano_parsed, ~ .x$SST$HYCOM$YEAR %||% NA_real_),
depth = map_dbl(oceano_parsed, ~ .x$BATH$ETOPO1 %||% NA_real_),
chl   = map_dbl(oceano_parsed, ~ .x$`CHLOR-A`$MODIS$YEAR %||% NA_real_)
) %>%
mutate(sst=ifelse(sst == -9999, NA, sst),
depth=ifelse(depth == -9999, NA, depth),
chl  =ifelse(chl   == -9999, NA, chl))
sperm_utm<-sperm_clean %>%
filter(!is.na(decimal_longitude) & !is.na(decimal_latitude)) %>%
add_utm_columns(ll_names=c("decimal_longitude", "decimal_latitude"),
units="m")
all_dates <- data.frame(
date = seq(min(sperm_clean$date), max(sperm_clean$date), by = "day")
)
sperm_daily<- sperm_clean %>%
group_by(date) %>%
summarise(count = n(),
sst   = mean(sst,   na.rm = TRUE),
depth = mean(depth, na.rm = TRUE),
chl   = mean(chl,   na.rm = TRUE)
)
sperm_full <- all_dates %>%
left_join(sperm_daily, by = "date") %>%
mutate(count = ifelse(is.na(count), 0, count),
month = month(date),
year  = year(date))
sum(sperm_full$count == 0)
table(sperm_full$count == 0)
table(sperm_full$count)
summary(sperm_full)
sperm_full <- sperm_full %>%
mutate(
sst_z   = scale(sst),
depth_z = scale(depth),
chl_z   = scale(chl)
)
nb_env <- stan_glm(
count ~ factor(month) + year_c + sst_z + depth_z + chl_z,
data = sperm_full,
family = neg_binomial_2,
chains = 4, iter = 2000
)
