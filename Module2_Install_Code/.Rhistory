lmf1<-lm(y~x,data=dataFunction,na.action=na.fail)
clusterEvalQ(library(MuMIn))
clusterExport(cl2,varlist=list("dataFunction","lmf1"),envir = environment())
lmf2<-dredge(lmf1,cluster = cl2)
lmf2
}
func1(dataGlobal)
