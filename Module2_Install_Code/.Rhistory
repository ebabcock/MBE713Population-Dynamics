library(MuMIn)
library(parallel)
cl2 <- makeCluster(4)
on.exit(stopCluster(cl2), add = TRUE)
func1 <- function(dataFunction, cl) {
lmf1 <- lm(y ~ x, data = dataFunction, na.action = na.fail)
# Ensure workers have package + objects in worker global env
clusterEvalQ(cl, library(MuMIn))
clusterExport(cl, varlist = c("lmf1", "dataFunction"), envir = environment())
# Try dredge in parallel
MuMIn::dredge(lmf1, cluster = cl)
}
set.seed(1)
dataGlobal <- data.frame(x = rnorm(20), y = rnorm(20))
func1(dataGlobal, cl2)
#Attempted revision.
